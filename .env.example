# Copy to .env (never commit .env). The Makefile and scripts/ load it automatically.
# Values must be single-line, without quotes.

# --- Kafka / Schema Registry (local docker) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# --- Snowflake account ---
# Account identifier <orgname>-<account_name> (Snowsight: account menu > View account details)
SNOWFLAKE_ACCOUNT=myorg-myaccount
# Same account as a URL, used by the Kafka connector
SNOWFLAKE_ACCOUNT_URL=myorg-myaccount.snowflakecomputing.com
# FOODDEL_{ENV}
SNOWFLAKE_DATABASE=FOODDEL_DEV

# --- Your own (human) user, used by scripts/sf.py to run the setup SQL ---
SNOWFLAKE_ADMIN_USER=MY_USER
SNOWFLAKE_ADMIN_ROLE=ACCOUNTADMIN
# Generated by `make sf-keygen`; register its public key once in Snowsight (keygen prints the SQL)
SNOWFLAKE_ADMIN_PRIVATE_KEY_PATH=secrets/admin_rsa_key.p8

# --- Kafka connector service user (created by snowflake/02_rbac.sql) ---
SNOWFLAKE_CONNECTOR_USER=SVC_KAFKA_CONNECTOR
# Both printed by `make sf-keygen` (key body only, no BEGIN/END lines)
SNOWFLAKE_CONNECTOR_PUBLIC_KEY=
SNOWFLAKE_CONNECTOR_PRIVATE_KEY=
