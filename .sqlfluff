[sqlfluff]
dialect = snowflake
templater = placeholder
max_line_length = 120
# LT05: column COMMENTs are long by nature. AM06: positional GROUP BY 1, 2 is idiomatic here.
exclude_rules = LT05, AM06

[sqlfluff:templater:placeholder]
param_style = dollar
SNOWFLAKE_DATABASE = FOODDEL_DEV
SNOWFLAKE_ADMIN_USER = ADMIN_USER
SNOWFLAKE_CONNECTOR_PUBLIC_KEY = MIIBIjANBg

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper
