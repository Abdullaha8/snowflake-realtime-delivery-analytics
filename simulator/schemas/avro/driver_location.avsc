{
  "type": "record",
  "name": "DriverLocation",
  "namespace": "com.fooddel.events",
  "doc": "DRIVER_LOCATION on topic fooddel.driver_locations.v1 (key: driver_id)",
  "fields": [
    {
      "name": "event_id",
      "type": "string"
    },
    {
      "name": "event_type",
      "type": "string"
    },
    {
      "name": "schema_version",
      "type": "long"
    },
    {
      "name": "event_ts",
      "type": "string",
      "doc": "when it happened (ISO-8601 UTC)"
    },
    {
      "name": "emitted_ts",
      "type": "string",
      "doc": "when it was sent (ISO-8601 UTC)"
    },
    {
      "name": "source",
      "type": "string"
    },
    {
      "name": "data",
      "type": {
        "type": "record",
        "name": "DriverLocationData",
        "fields": [
          {
            "name": "driver_id",
            "type": "string"
          },
          {
            "name": "lat",
            "type": "double"
          },
          {
            "name": "lng",
            "type": "double"
          },
          {
            "name": "h3_r8",
            "type": "string"
          },
          {
            "name": "zone_id",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "status",
            "type": "string"
          },
          {
            "name": "order_id",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "speed_kmh",
            "type": "double"
          },
          {
            "name": "battery_pct",
            "type": "long"
          }
        ]
      }
    }
  ]
}
