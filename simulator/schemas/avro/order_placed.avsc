{
  "type": "record",
  "name": "OrderPlaced",
  "namespace": "com.fooddel.events",
  "doc": "ORDER_PLACED on topic fooddel.orders.v1 (key: order_id)",
  "fields": [
    {
      "name": "event_id",
      "type": "string"
    },
    {
      "name": "event_type",
      "type": "string"
    },
    {
      "name": "schema_version",
      "type": "long"
    },
    {
      "name": "event_ts",
      "type": "string",
      "doc": "when it happened (ISO-8601 UTC)"
    },
    {
      "name": "emitted_ts",
      "type": "string",
      "doc": "when it was sent (ISO-8601 UTC)"
    },
    {
      "name": "source",
      "type": "string"
    },
    {
      "name": "data",
      "type": {
        "type": "record",
        "name": "OrderPlacedData",
        "fields": [
          {
            "name": "order_id",
            "type": "string"
          },
          {
            "name": "customer_id",
            "type": "string"
          },
          {
            "name": "restaurant_id",
            "type": "string"
          },
          {
            "name": "zone_id",
            "type": "string"
          },
          {
            "name": "h3_r8",
            "type": "string"
          },
          {
            "name": "delivery_lat",
            "type": "double"
          },
          {
            "name": "delivery_lng",
            "type": "double"
          },
          {
            "name": "items",
            "type": {
              "type": "array",
              "items": {
                "type": "record",
                "name": "OrderItem",
                "fields": [
                  {
                    "name": "item_id",
                    "type": "string"
                  },
                  {
                    "name": "name",
                    "type": "string"
                  },
                  {
                    "name": "qty",
                    "type": "long"
                  },
                  {
                    "name": "unit_price_inr",
                    "type": "long"
                  }
                ]
              }
            }
          },
          {
            "name": "subtotal_inr",
            "type": "long"
          },
          {
            "name": "delivery_fee_inr",
            "type": "long"
          },
          {
            "name": "surge_fee_inr",
            "type": "long"
          },
          {
            "name": "discount_inr",
            "type": "long"
          },
          {
            "name": "total_inr",
            "type": "long"
          },
          {
            "name": "payment_method",
            "type": "string"
          },
          {
            "name": "promised_eta_min",
            "type": "long"
          },
          {
            "name": "is_raining",
            "type": "boolean"
          }
        ]
      }
    }
  ]
}
